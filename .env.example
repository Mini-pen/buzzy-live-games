# * Public host served by Traefik (DNS must point to the host running Traefik).
GAMES_HOST=games.from-beyond.fr

# * Sub-path the app is mounted under, on GAMES_HOST. Used both as the Vite build
#   base (APP_BASE_PATH build arg) and the server BASE_PATH env. Leave as "/" to
#   serve at the domain root instead.
APP_BASE_PATH=/buzzy-live-games

# * Full public URL including the sub-path (QR codes, admin resume links).
PUBLIC_URL=https://games.from-beyond.fr/buzzy-live-games

# * Required. Signing secret for player/admin JWTs.
JWT_SECRET=
